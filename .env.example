# Copy to .env (gitignored) and fill in. CI reads the same names from GitHub Actions secrets.

# Judge LLM (config/lab.yaml models.judge_llm), from M4
ANTHROPIC_API_KEY=

# Point the lab at services outside docker compose, e.g. native Ollama on the GPU host
# LAB_OLLAMA_URL=http://localhost:11434
# LAB_QDRANT_URL=http://localhost:6333

# Agent LLM (M4): a native Ollama on the GPU host, separate from the Docker one that embeds
# LAB_AGENT_LLM_URL=http://localhost:11435
# LAB_AGENT_MODEL=llama3.1:8b

# Report site deploys (D1). Locally, `wrangler login` is enough; CI needs a scoped token.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
